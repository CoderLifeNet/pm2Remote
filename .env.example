# Recommended: npm run setup generates .env and random secrets for you.
# There are NO default login credentials. Choose your username and password.
UI_USERNAME=
# Generate with npm run hash-password. Keep the single quotes around the hash.
UI_PASSWORD_HASH=''

# Generate each value independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PM2_READ_TOKEN=
PM2_CONTROL_TOKEN=

# Exact PM2 application names, comma-separated. Never include this controller.
PM2_ALLOWED_NAMES=my-api,my-worker
PORT=3100

# Must exactly match the URL you open, without a trailing slash.
# These defaults are for localhost or an SSH tunnel:
PUBLIC_ORIGIN=http://localhost:3100
COOKIE_SECURE=false

# For a domain behind an HTTPS reverse proxy, instead use:
# PUBLIC_ORIGIN=https://pm2.example.com
# COOKIE_SECURE=true

# Optional: use the same PM2_HOME as the account running your existing apps.
# PM2_HOME=/home/your-user/.pm2
