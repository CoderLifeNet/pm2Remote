            "description": "Rate limited"
          },
          "503": {
            "description": "Service or helper unavailable"
          }
        }
      }
    },
    "/v1/pm2/command": {
      "post": {
        "operationId": "runPm2Command",
        "summary": "Run a PM2 command in full mode with control access",
        "description": "Fixed CLI executable, clean environment. Root uses private helper. Deadline 30s, output 128KB. Timed-out operations may continue in daemon.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required for session authentication; ignored for bearer authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Must match PUBLIC_ORIGIN for session authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-PM2-Instance",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "root"
              ],
              "default": "user"
            },
            "description": "Root requires configured private helper. Invalid targets are rejected."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "minItems": 1,
                    "maxItems": 128
                  },
                  "command": {
                    "type": "string",
                    "maxLength": 16384
                  },
                  "environment": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "args"
                    ],
                    "not": {
                      "required": [
                        "command"
                      ]
                    }
                  },
                  {
                    "required": [
                      "command"
                    ],
                    "not": {
                      "required": [
                        "args"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect ok and timedOut; HTTP 200 does not guarantee command success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid command, environment or instance"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Control access, full mode or session CSRF required"
          },
          "409": {
            "description": "Another instance command is running"
          },
          "413": {
            "description": "Command JSON exceeds 24 KB"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service or helper unavailable"
          }
        }
      }
    },
