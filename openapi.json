{
  "openapi": "3.1.0",
  "info": {
    "title": "PM2 control API",
    "version": "2.0.0",
    "description": "Login-protected PM2 dashboard. Restricted mode limits names; opt-in full mode grants command access to the selected service-user or root PM2 instance."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100",
      "description": "Local listener or SSH tunnel"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/v1/processes": {
      "get": {
        "operationId": "listProcesses",
        "summary": "List allowed processes with sanitized metrics",
        "responses": {
          "200": {
            "description": "Allowed processes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "processes"
                  ],
                  "properties": {
                    "processes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Process"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PM2 operation failed; outcome may be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-PM2-Instance",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "root"
              ],
              "default": "user"
            },
            "description": "Root requires configured private helper. Invalid targets are rejected."
          }
        ]
      }
    },
    "/v1/processes/{id}/restart": {
      "post": {
        "operationId": "restartProcess",
        "summary": "Restart an allowed process (control token required)",
        "description": "Send no request body. Numeric PM2 ID only. Success confirms PM2 callback, not application health. Do not automatically retry uncertain outcomes.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required for session authentication; ignored for bearer authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Must match PUBLIC_ORIGIN for session authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-PM2-Instance",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "root"
              ],
              "default": "user"
            },
            "description": "Root requires configured private helper. Invalid targets are rejected."
          }
        ],
        "responses": {
          "200": {
            "description": "PM2 callback succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "id",
                    "action"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "id": {
                      "type": "integer"
                    },
                    "action": {
                      "const": "restart"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID or nonempty body"
          },
          "403": {
            "description": "Insufficient role or invalid session CSRF/Origin"
          },
          "404": {
            "description": "Process absent, disallowed or controller itself"
          },
          "401": {
            "description": "Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PM2 operation failed; outcome may be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
