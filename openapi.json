{
  "openapi": "3.1.0",
  "info": {
    "title": "PM2 control API",
    "version": "1.1.0",
    "description": "Single-operator login dashboard and PM2 API. Same-origin sessions require CSRF and Origin on all writes. Automation uses separate bearer tokens."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100",
      "description": "Local listener or SSH tunnel"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/v1/processes": {
      "get": {
        "operationId": "listProcesses",
        "summary": "List allowed processes with sanitized metrics",
        "responses": {
          "200": {
            "description": "Allowed processes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "processes"
                  ],
                  "properties": {
                    "processes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Process"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PM2 operation failed; outcome may be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/processes/{id}/restart": {
      "post": {
        "operationId": "restartProcess",
        "summary": "Restart an allowed process (control token required)",
        "description": "Send no request body. Numeric PM2 ID only. Success confirms PM2 callback, not application health. Do not automatically retry uncertain outcomes.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required for session authentication; ignored for bearer authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Must match PUBLIC_ORIGIN for session authentication.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PM2 callback succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "id",
                    "action"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "id": {
                      "type": "integer"
                    },
                    "action": {
                      "const": "restart"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID or nonempty body"
          },
          "403": {
            "description": "Insufficient role or invalid session CSRF/Origin"
          },
          "404": {
            "description": "Process absent, disallowed or controller itself"
          },
          "401": {
            "description": "Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PM2 operation failed; outcome may be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/processes/{id}/reload": {
      "post": {
        "operationId": "reloadProcess",
        "summary": "Reload an allowed process (control token required)",
        "description": "Send no request body. Numeric PM2 ID only. Success confirms PM2 callback, not application health. Do not automatically retry uncertain outcomes.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required for session authentication; ignored for bearer authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Must match PUBLIC_ORIGIN for session authentication.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PM2 callback succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "id",
                    "action"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "id": {
                      "type": "integer"
                    },
                    "action": {
                      "const": "reload"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID or nonempty body"
          },
          "403": {
            "description": "Insufficient role or invalid session CSRF/Origin"
          },
          "404": {
            "description": "Process absent, disallowed or controller itself"
          },
          "401": {
            "description": "Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PM2 operation failed; outcome may be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/processes/{id}/stop": {
      "post": {
        "operationId": "stopProcess",
        "summary": "Stop an allowed process (control token required)",
        "description": "Send no request body. Numeric PM2 ID only. Success confirms PM2 callback, not application health. Do not automatically retry uncertain outcomes.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "description": "Required for session authentication; ignored for bearer authentication.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Must match PUBLIC_ORIGIN for session authentication.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PM2 callback succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "id",
                    "action"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "id": {
                      "type": "integer"
                    },
                    "action": {
                      "const": "stop"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID or nonempty body"
          },
          "403": {
            "description": "Insufficient role or invalid session CSRF/Origin"
          },
          "404": {
            "description": "Process absent, disallowed or controller itself"
          },
          "401": {
            "description": "Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PM2 operation failed; outcome may be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getSession",
        "security": [],
        "summary": "Read session state and establish a pre-login CSRF session",
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Expired session; fetch again to establish a new session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "summary": "Sign in with configured operator credentials",
        "description": "Requires a pre-login cookie from /auth/session. Rotates the session ID and CSRF token.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured PUBLIC_ORIGIN"
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token returned by /auth/session; rotates on login"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 2KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Login or global rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Revoke browser session and clear cookie",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured PUBLIC_ORIGIN"
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token returned by /auth/session; rotates on login"
          }
        ],
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random 32-byte lowercase hex token. Read token: GET only. Control token: GET and POST."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-pm2.sid",
        "description": "Secure production session cookie; local SSH mode uses pm2.sid. Obtain via login."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Process": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "cpu",
          "memory",
          "startedAt",
          "restarts"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "cpu": {
            "type": [
              "number",
              "null"
            ]
          },
          "memory": {
            "type": [
              "number",
              "null"
            ],
            "description": "Bytes"
          },
          "startedAt": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix milliseconds"
          },
          "restarts": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "authenticated",
          "username",
          "role",
          "csrfToken"
        ]
      }
    }
  }
}
